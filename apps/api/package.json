{
  "name": "@reachinbox/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:seed": "tsx src/db/seed.ts",
    "smoke:schedule": "tsx src/scripts/smoke-schedule.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.14.1",
    "@bull-board/express": "^6.14.1",
    "@elastic/elasticsearch": "^8.15.0",
    "@prisma/client": "^6.15.0",
    "bullmq": "^5.58.5",
    "cors": "^2.8.5",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "redis": "^5.8.2",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.3.0",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.0.0",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
