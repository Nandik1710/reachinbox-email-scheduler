NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

DATABASE_URL=mysql://app:app@localhost:3306/email_scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=scheduled-emails
SEARCH_INDEX_MAX_ATTEMPTS=3
SEARCH_INDEX_RETRY_DELAY_MS=250
LOG_LEVEL=info

# Google OAuth - create a Web application client in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SESSION_SECRET=

# Ethereal SMTP - configure in Prompt 5
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Slack OAuth - configure in Prompt 6
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/integrations/slack/callback
# 32-byte AES-256 key encoded as 64 hexadecimal characters; generate with `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SLACK_TOKEN_ENCRYPTION_KEY=

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
EMAIL_QUEUE_NAME=email-sends
EMAIL_MAX_ATTEMPTS=3
PROCESSING_TIMEOUT_MS=300000

# Local seed data only; these are not OAuth credentials
SEED_DEMO_GOOGLE_ID=local-demo-user
SEED_DEMO_EMAIL=demo@local.test
SEED_DEMO_NAME=Local Demo User
